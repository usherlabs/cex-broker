{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://usher.so/fiet-maker/reference-depth-clock-derivation-descriptor/v1",
	"title": "Maker reference-depth clock derivation descriptor v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_id",
		"schema_sha256",
		"descriptor_sha256",
		"stage",
		"materializer",
		"maker_policy_configuration_sha256",
		"scheduler_contract_id",
		"inputs",
		"source_evidence",
		"original_clock",
		"admitted_clock",
		"target_mappings",
		"blocked_dispositions_sha256",
		"counts",
		"scope",
		"freshness_expiry"
	],
	"properties": {
		"schema_id": {
			"const": "https://usher.so/fiet-maker/reference-depth-clock-derivation-descriptor/v1"
		},
		"schema_sha256": { "$ref": "#/$defs/sha256" },
		"descriptor_sha256": { "$ref": "#/$defs/sha256" },
		"stage": { "enum": ["candidate_a_bootstrap", "candidate_c_final"] },
		"materializer": {
			"type": "object",
			"additionalProperties": false,
			"required": ["identity", "version"],
			"properties": {
				"identity": { "$ref": "#/$defs/nonEmpty" },
				"version": { "$ref": "#/$defs/nonEmpty" }
			}
		},
		"maker_policy_configuration_sha256": { "$ref": "#/$defs/sha256" },
		"scheduler_contract_id": { "const": "native_chronological_scheduler_v2" },
		"inputs": {
			"type": "object",
			"additionalProperties": false,
			"required": ["dex", "bootstrap_okx_tape"],
			"properties": {
				"dex": {
					"type": "array",
					"maxItems": 10000,
					"items": { "$ref": "#/$defs/artifact" }
				},
				"bootstrap_okx_tape": {
					"oneOf": [{ "type": "null" }, { "$ref": "#/$defs/tape" }]
				}
			}
		},
		"source_evidence": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"nominal_ledger_sha256",
				"source_qualification_record_sha256"
			],
			"properties": {
				"nominal_ledger_sha256": { "$ref": "#/$defs/sha256" },
				"source_qualification_record_sha256": { "$ref": "#/$defs/sha256" }
			}
		},
		"original_clock": { "$ref": "#/$defs/clock" },
		"admitted_clock": { "$ref": "#/$defs/clock" },
		"target_mappings": {
			"type": "array",
			"maxItems": 100000,
			"items": { "$ref": "#/$defs/mapping" }
		},
		"blocked_dispositions_sha256": { "$ref": "#/$defs/sha256" },
		"counts": { "$ref": "#/$defs/counts" },
		"scope": { "$ref": "#/$defs/scope" },
		"freshness_expiry": { "$ref": "#/$defs/freshness" }
	},
	"$defs": {
		"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"uuid": {
			"type": "string",
			"pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
		},
		"uint": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
		"nonEmpty": { "type": "string", "minLength": 1, "maxLength": 512 },
		"timestamp": {
			"type": "string",
			"pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
		},
		"artifact": {
			"type": "object",
			"additionalProperties": false,
			"required": ["identity", "sha256"],
			"properties": {
				"identity": { "$ref": "#/$defs/nonEmpty" },
				"sha256": { "$ref": "#/$defs/sha256" }
			}
		},
		"tape": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"manifest_sha256",
				"selection_sha256",
				"receipt_sha256s",
				"export_result_sha256",
				"artifact_sha256s",
				"projection_schema_sha256s"
			],
			"properties": {
				"manifest_sha256": { "$ref": "#/$defs/sha256" },
				"selection_sha256": { "$ref": "#/$defs/sha256" },
				"receipt_sha256s": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/sha256" }
				},
				"export_result_sha256": { "$ref": "#/$defs/sha256" },
				"artifact_sha256s": {
					"type": "array",
					"minItems": 2,
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/sha256" }
				},
				"projection_schema_sha256s": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/sha256" }
				}
			}
		},
		"clock": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"clock_id",
				"clock_sha256",
				"clock_bytes_sha256",
				"projection_sha256",
				"event_count"
			],
			"properties": {
				"clock_id": { "$ref": "#/$defs/uuid" },
				"clock_sha256": { "$ref": "#/$defs/sha256" },
				"clock_bytes_sha256": { "$ref": "#/$defs/sha256" },
				"projection_sha256": { "$ref": "#/$defs/sha256" },
				"event_count": { "$ref": "#/$defs/uint" }
			}
		},
		"mapping": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"original_target_id",
				"admitted_target_id",
				"disposition",
				"maker_event_ids"
			],
			"properties": {
				"original_target_id": { "$ref": "#/$defs/uuid" },
				"admitted_target_id": {
					"oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }]
				},
				"disposition": { "enum": ["admitted", "reference_depth_stale"] },
				"maker_event_ids": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/nonEmpty" }
				}
			}
		},
		"counts": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"cex_target_count",
				"maker_invocation_count",
				"admitted_target_count",
				"admitted_invocation_count",
				"blocked_target_count",
				"blocked_invocation_count"
			],
			"properties": {
				"cex_target_count": { "$ref": "#/$defs/uint" },
				"maker_invocation_count": { "$ref": "#/$defs/uint" },
				"admitted_target_count": { "$ref": "#/$defs/uint" },
				"admitted_invocation_count": { "$ref": "#/$defs/uint" },
				"blocked_target_count": { "$ref": "#/$defs/uint" },
				"blocked_invocation_count": { "$ref": "#/$defs/uint" }
			}
		},
		"pin": {
			"type": "object",
			"additionalProperties": false,
			"required": ["policy_id", "policy_sha256"],
			"properties": {
				"policy_id": { "$ref": "#/$defs/nonEmpty" },
				"policy_sha256": { "$ref": "#/$defs/sha256" }
			}
		},
		"scope": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"trading_pair",
				"window_start",
				"window_end",
				"capability_policy",
				"resource_policy",
				"depth",
				"source_policy",
				"max_prior_asof_lag_ms"
			],
			"properties": {
				"trading_pair": { "enum": ["ARB-USDC", "ARB-USDT"] },
				"window_start": { "$ref": "#/$defs/timestamp" },
				"window_end": { "$ref": "#/$defs/timestamp" },
				"capability_policy": { "$ref": "#/$defs/pin" },
				"resource_policy": { "$ref": "#/$defs/pin" },
				"depth": { "const": 100 },
				"source_policy": { "const": "fill_gaps" },
				"max_prior_asof_lag_ms": { "const": 5000 }
			}
		},
		"freshness": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"threshold_ms",
				"comparison",
				"trigger",
				"scheduler_contract_id",
				"source_update_precedes_controller_evaluation"
			],
			"properties": {
				"threshold_ms": { "const": 5000 },
				"comparison": { "const": "strict_greater_than" },
				"trigger": { "const": "first_actual_policy_opportunity" },
				"scheduler_contract_id": {
					"const": "native_chronological_scheduler_v2"
				},
				"source_update_precedes_controller_evaluation": { "const": true }
			}
		}
	}
}
