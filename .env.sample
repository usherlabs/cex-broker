
# Required for CLI and broker

CEX_BROKER_BYBIT_API_KEY=***********************
CEX_BROKER_BINANCE_API_KEY=****************************************
CEX_BROKER_BYBIT_API_SECRET=***********************************************
CEX_BROKER_BINANCE_API_SECRET=************************************************************
LOG_LEVEL=debug
CEX_BROKER_SANDBOX_MODE=true

# Broker surface (optional): split read vs write deployments
# Read broker (outside TEE): fetch actions + ORDERBOOK/TRADES/TICKER/OHLCV streams
# Write broker (inside TEE): orders, withdrawals, transfers + ORDERS/BALANCE streams
# Defaults: both enabled
# CEX_BROKER_READ_ENABLED=true
# CEX_BROKER_WRITE_ENABLED=true

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=cex-broker

# ClickHouse research / market data archive (optional)
# Broker → forwarder
CEX_BROKER_ARCHIVE_FORWARDER_URL=http://localhost:8090/archive
CEX_BROKER_DEPLOYMENT_ID=local-dev
# ClickHouse (forwarder, candle-viewer, Python)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
