
# Required for CLI and Optional for the Broker Library

CEX_BROKER_BYBIT_API_KEY=***********************
CEX_BROKER_BINANCE_API_KEY=****************************************
CEX_BROKER_BYBIT_API_SECRET=***********************************************
CEX_BROKER_BINANCE_API_SECRET=************************************************************
LOG_LEVEL=debug
CEX_BROKER_SANDBOX_MODE=true

# OpenTelemetry Configuration
# Use OTEL_EXPORTER_OTLP_ENDPOINT for the full OTLP endpoint (preferred)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=cex-broker

# Or use legacy host/port configuration
# CEX_BROKER_OTEL_HOST=otel-collector
# CEX_BROKER_OTEL_PORT=4318
# CEX_BROKER_OTEL_PROTOCOL=http

# ClickHouse research / market data archive
# CEX_BROKER_CLICKHOUSE_HOST=archive-forwarder
# CEX_BROKER_ARCHIVE_FORWARDER_HOST=archive-forwarder
# CEX_BROKER_ARCHIVE_FORWARDER_PORT=8090
# CEX_BROKER_ARCHIVE_FORWARDER_PATH=/archive
# CEX_BROKER_ARCHIVE_FORWARDER_URL=http://archive-forwarder:8090/archive
# CEX_BROKER_MARKET_ARCHIVE_ENABLED=true
# CEX_BROKER_DEPLOYMENT_ID=local-dev
# CEX_BROKER_ARCHIVE_OTEL_LOGS_ENABLED=false

# Archive forwarder service (services/archive-forwarder)
# ARCHIVE_FORWARDER_PORT=8090
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=market_data