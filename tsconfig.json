{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false
	},
	"exclude": ["**/*.test.ts", "**/*.spec.ts", "test", "e2e", "node_modules", "dist", "build"],
	"include": ["src/index.ts", "services/archive-forwarder/**/*.ts", "scripts/archive-sidecar.ts", "scripts/archive-sidecar-supervisor.ts", "scripts/generate-orderbook-summary-v2-conformance.ts", "build.ts"]
}
